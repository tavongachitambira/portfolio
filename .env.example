# Copy to .env.local and fill in. Everything is optional except where noted:
# the site runs without any of it, and each feature switches on when its keys exist.

# --- Contact form (required for the form to send; otherwise it opens the visitor's mail app) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_EMAIL=

# --- Spam protection: rate limiting that holds across serverless instances (Upstash Redis REST) ---
# Without these the limiter uses per-instance memory, which is fine locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Spam protection: Cloudflare Turnstile (invisible unless a challenge is needed) ---
# Local testing: site key 1x00000000000000000000BB (invisible, always passes)
#                secret   1x0000000000000000000000000000000AA (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- "Ask my portfolio": needs ONE provider key (server side). The Ask button only shows with NEXT_PUBLIC_ASK_ENABLED=true (inlined at build time, so redeploy after changing it) ---
# Google Gemini has a free tier (key from Google AI Studio); Grok and Claude are pay per token.
GEMINI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# With several keys set, pick one (gemini | xai or grok | anthropic); otherwise Anthropic, then Gemini, then Grok.
# ASK_PROVIDER=gemini
# Optional overrides. Defaults: gemini-3.1-flash-lite | grok-4.7 | claude-haiku-5-5
# ASK_MODEL=
# ASK_EFFORT=low           # low | medium | high; "none" sends nothing. Unset: low, except Gemini's own default
# ASK_MAX_TOKENS=2048      # 0 sends no limit (Gemini and Grok only)
# ASK_DAILY_CAP=500        # on Gemini's free tier keep this below your project's daily quota
# ASK_DISABLED=true
# ASK_BASE_URL=http://127.0.0.1:4010   # a local mock: pnpm mock:ask
NEXT_PUBLIC_ASK_ENABLED=false
